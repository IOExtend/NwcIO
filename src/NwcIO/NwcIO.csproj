<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>NwcIO</PackageId>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- CompatibilitySuppressions.xml accepts the removal of NwcIO.Internal types that 0.12.1 exposed;
         delete it when this baseline moves to a release that no longer contains them. -->
    <PackageValidationBaselineVersion>0.12.1</PackageValidationBaselineVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BuildNativeCoreOnly)' == 'true'">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(BuildNativeCoreOnly)' == 'true'">
    <Compile Remove="Compatibility/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NwcIO.Tests" />
    <InternalsVisibleTo Include="NwcIO.Scene.Tests" />
  </ItemGroup>

</Project>
