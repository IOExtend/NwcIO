<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Local runs use one TFM; CI and the release gate exercise both shipped runtimes. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="IfcIO" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Schemas\Bcf21\*.xsd" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NwcIO\NwcIO.csproj" />
    <ProjectReference Include="..\..\src\NwcIO.Cli\NwcIO.Cli.csproj" />
  </ItemGroup>

</Project>
